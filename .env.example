# =============================================================================
# EdgeOne Deployment — Environment Variables
# =============================================================================
# Configure these variables in the EdgeOne Console:
#   1. Navigate to Edge Functions > Environment Variables
#   2. Add each variable below as a key-value pair
#   3. Deploy your Edge Function after saving
#
# IMPORTANT: .env.local contains Vercel-specific variables (VERCEL_*, TURBO_*)
# that are NOT required on EdgeOne. Remove or ignore .env.local during migration.
# =============================================================================

# PgBouncer session pooler (port 6543) — used by Prisma Client at runtime
DATABASE_URL="postgresql://postgres.xxx:xxx@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — used by Prisma CLI for migrations (DDL operations)
DIRECT_URL="postgresql://postgres.xxx:xxx@aws-0-us-west-1.supabase.com:5432/postgres"

# Used in lib/prisma.ts (global caching guard) and app/api/test/premium-session/route.ts (route guard)
NODE_ENV="production"
